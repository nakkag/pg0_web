// Copy this file to server_settings.local.js and set the values for this server.
// server_settings.local.js is ignored by git, so it is kept when the sources are replaced.
// Only the values written here override server_settings.js; the rest keep their defaults.

exports.dbOption = 'mongodb://user:pass@127.0.0.1:27017/pg0';

exports.key = 'privkey.pem';
exports.cert = 'cert.pem';

exports.httpsPort = 443;
exports.httpPort = 80;
